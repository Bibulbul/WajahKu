# Salin menjadi .env.production.local saat build untuk server production.
# Kosongkan kalau frontend dan backend memakai domain yang sama
# (server meneruskan /api dan /static ke Flask).
# Isi alamat backend tanpa /api kalau domainnya berbeda, mis.:
# VITE_API_URL=https://api.wajahku.id
VITE_API_URL=
